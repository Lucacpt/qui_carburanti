{
  // Dominio, script Node e test. Il Worker ha un tsconfig separato
  // (tsconfig.worker.json) perché i tipi runtime Cloudflare e @types/node
  // definiscono in modo diverso Request/Response.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/domain", "src/**/*.test.ts", "scripts", "vitest.config.ts"]
}
