/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/.well-known/security.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8

https://staging.quicarburanti.it/*
  X-Robots-Tag: noindex, nofollow

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/r/*
  Cache-Control: public, max-age=31536000, immutable

/r/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=300

# File di testo per motori e modelli di IA: UTF-8 esplicito, o gli accenti si rompono.
/robots.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8

/llms.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
