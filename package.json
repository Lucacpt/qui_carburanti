{
  "name": "qui",
  "version": "0.1.6",
  "private": true,
  "description": "QUI — dove c'è carburante, adesso. Segnalazioni anonime durante le carenze.",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --var DEV_ERRORS:1 --local-upstream localhost",
    "smoke": "node scripts/smoke.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "node scripts/build-client.ts && node scripts/build-seo.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.ts",
    "privacy-guard": "node scripts/privacy-guard.ts",
    "legal-check": "node scripts/check-legal.ts",
    "import:mimit": "node scripts/import-mimit.ts AV",
    "import:comuni": "node scripts/import-comuni.ts AV"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
