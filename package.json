{
  "name": "qui",
  "version": "0.1.0",
  "private": true,
  "description": "QUI — dove c'è carburante, adesso. Segnalazioni anonime durante le carenze.",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --var DEV_ERRORS:1",
    "smoke": "node scripts/smoke.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.ts",
    "privacy-guard": "node scripts/privacy-guard.ts",
    "import:mimit": "node scripts/import-mimit.ts AV",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
