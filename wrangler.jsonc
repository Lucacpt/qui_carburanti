{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qui",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // La radice è la produzione: solo il dominio. Niente *.workers.dev né URL di anteprima, che
  // userebbero gli stessi Durable Objects e scriverebbero dati reali (SDD §12). www → apex è una
  // Redirect Rule di Cloudflare: il Worker non la vede (docs/procedure/rilascio.md).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "quicarburanti.it", "custom_domain": true }],
  // Prima di `wrangler dev` e `wrangler deploy`: il client (public/app.js, pow.js, admin.js), poi
  // public/sitemap.xml e public/llms-full.txt, generati da anagrafica e pagine (seguono i dati veri).
  "build": { "command": "node scripts/build-client.ts && node scripts/build-seo.ts" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /d/<id> e le altre rotte del client servono index.html
    "not_found_handling": "single-page-application",
    // solo le API passano dal Worker: gli asset statici restano gratuiti
    "run_worker_first": ["/api/*"]
  },
  // Residenza UE (ADR-0012). I Durable Objects sono l'unico archivio di QUI. wrangler non ha un
  // campo "jurisdiction" per loro: il vincolo è nel codice (src/worker/jurisdiction.ts: namespace
  // "eu" + ogni oggetto verifica la propria giurisdizione) e scripts/region-policy.test.ts
  // controlla questo file a ogni PR. Nuovi archivi (KV, D1, R2…) vanno prima verificati lì.
  "durable_objects": {
    "bindings": [
      { "name": "PROVINCE", "class_name": "ProvinceDO" },
      { "name": "KEYS", "class_name": "KeyDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProvinceDO", "KeyDO"] }],
  // Limite grossolano per rete anonima (pkey): 30 al minuto, alto per via del CGNAT. Contestazioni
  // su un contatore separato: finiscono al maintainer, quindi un limite proprio (anti-raffica).
  "ratelimits": [
    { "name": "RL_REPORT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CONTEST", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "PROVINCES": "AV",
    // Obbligatorio "eu" in OGNI ambiente di deploy: le vars non si ereditano tra env, e senza
    // questa variabile il Worker si ferma. Solo in locale .dev.vars usa "none" (workerd non la supporta).
    "DO_JURISDICTION": "eu",
    // ~50.000 hash SHA-256: circa mezzo secondo su un telefono di fascia media
    "POW_MAX": "50000"
  },
  // POW_SECRET è un secret: `wrangler secret put POW_SECRET` (in locale: file .dev.vars)
  // Niente log applicativi in produzione (NFR-PR6). Si riattivano solo per il debug.
  "observability": { "enabled": false },
  // Nessun "placement" di proposito: il Worker gira nel data center più vicino a chi lo usa (in
  // Italia per chi è in Italia). Il placement per regione è best effort e non garantisce dove
  // passano i dati; decifrare HTTPS solo nell'UE richiede Regional Services (Enterprise). ADR-0012.
  "env": {
    // Worker "qui-staging": Durable Objects propri, quindi dati separati dalla produzione.
    // routes si eredita: va ridefinito, o lo staging si prenderebbe il dominio di produzione.
    // vars e binding non si ereditano: vanno ripetuti (scripts/deploy-policy.test.ts lo controlla).
    "staging": {
      "routes": [{ "pattern": "staging.quicarburanti.it", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "PROVINCE", "class_name": "ProvinceDO" },
          { "name": "KEYS", "class_name": "KeyDO" }
        ]
      },
      "ratelimits": [
        { "name": "RL_REPORT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_CONTEST", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": { "PROVINCES": "AV", "DO_JURISDICTION": "eu", "POW_MAX": "50000" },
      "observability": { "enabled": false }
    }
  }
}
