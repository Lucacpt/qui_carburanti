{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qui",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Costruisce public/app.js e public/pow.js prima di `wrangler dev` e `wrangler deploy`.
  "build": { "command": "node scripts/build-client.ts" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /d/<id> e le altre rotte del client servono index.html
    "not_found_handling": "single-page-application",
    // solo le API passano dal Worker: gli asset statici restano gratuiti
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROVINCE", "class_name": "ProvinceDO" },
      { "name": "KEYS", "class_name": "KeyDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProvinceDO", "KeyDO"] }],
  // Limite grossolano per rete anonima (pkey): 30 segnalazioni al minuto, alto per via del CGNAT.
  "ratelimits": [
    { "name": "RL_REPORT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "PROVINCES": "AV",
    // Dati dei Durable Objects vincolati all'UE. In locale .dev.vars lo sovrascrive con "none" (non supportato).
    "DO_JURISDICTION": "eu",
    // ~50.000 hash SHA-256: circa mezzo secondo su un telefono di fascia media
    "POW_MAX": "50000"
  },
  // POW_SECRET è un secret: `wrangler secret put POW_SECRET` (in locale: file .dev.vars)
  // Niente log applicativi in produzione (NFR-PR6). Si riattivano solo per il debug.
  "observability": { "enabled": false }
}
